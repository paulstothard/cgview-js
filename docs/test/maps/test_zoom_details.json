{
  "cgview": {
    "version": "1.9.0",
    "name": "Zoom detail: translation, ruler, and inline labels",
    "settings": {
      "format": "circular",
      "geneticCode": 11,
      "backgroundColor": "white",
      "showShading": true,
      "showFeatureDirectionIndicators": true,
      "showBorder": false,
      "arrowHeadLength": 0.25,
      "initialMapThicknessProportion": 0.16,
      "maxMapThicknessProportion": 0.5
    },
    "backbone": {
      "color": "rgba(95,99,104,1)",
      "thickness": 5,
      "decoration": "arc"
    },
    "ruler": {
      "font": "sans-serif,plain,10",
      "color": "rgba(45,49,55,1)",
      "labelPosition": "outer",
      "labelStyle": "curved",
      "labelHaloWidth": 3
    },
    "annotation": {
      "font": "sans-serif,bold,13",
      "labelPosition": "both",
      "inlineLabelAllowShrinking": true,
      "inlineLabelAllowTruncation": false,
      "inlineLabelMinZoomFactor": 1,
      "inlineLabelMinFontSize": 8,
      "inlineLabelPadding": 2,
      "visible": true
    },
    "dividers": {
      "slot": {"visible": true, "color": "rgba(255,255,255,0.75)", "thickness": 1, "spacing": 1},
      "track": {"visible": true, "color": "rgba(70,70,70,0.6)", "thickness": 1, "spacing": 2}
    },
    "legend": {
      "position": "top-right",
      "backgroundColor": "rgba(255,255,255,0.82)",
      "items": [
        {"name": "Replication", "swatchColor": "rgba(32,116,174,0.86)", "decoration": "arrow"},
        {"name": "Regulation", "swatchColor": "rgba(240,160,48,0.9)", "decoration": "arrow"},
        {"name": "Transport", "swatchColor": "rgba(68,150,93,0.9)", "decoration": "arrow"}
      ]
    },
    "sequence": {
      "font": "monospace,plain,13",
      "color": "rgba(25,28,32,1)",
      "seq": "",
      "translation": {
        "visible": true,
        "font": "monospace,bold,10",
        "highlightStartCodons": true,
        "highlightStopCodons": true,
        "startColor": "#dcfce7",
        "startBorderColor": "#16a34a",
        "startTextColor": "#166534",
        "stopColor": "#fee2e2",
        "stopBorderColor": "#b91c1c",
        "stopTextColor": "#b91c1c",
        "edgePadding": 6,
        "minimumScale": 0.5
      }
    },
    "features": [
      {"name": "DNA polymerase", "type": "CDS", "start": 12, "stop": 104, "strand": 1, "source": "zoom-detail", "legend": "Replication"},
      {"name": "putative small transcriptional regulator", "type": "CDS", "start": 112, "stop": 178, "strand": 1, "source": "zoom-detail", "legend": "Regulation"},
      {"name": "membrane transporter alpha", "type": "CDS", "start": 190, "stop": 322, "strand": 1, "source": "zoom-detail", "legend": "Transport"},
      {"name": "small DNA-binding protein gamma", "type": "CDS", "start": 326, "stop": 352, "strand": 1, "source": "zoom-detail", "legend": "Regulation"},
      {"name": "reverse helicase", "type": "CDS", "start": 36, "stop": 158, "strand": -1, "source": "zoom-detail", "legend": "Replication"},
      {"name": "ATPase beta", "type": "CDS", "start": 210, "stop": 347, "strand": -1, "source": "zoom-detail", "legend": "Transport"}
    ],
    "tracks": [
      {"name": "Zoom-detail features", "separateFeaturesBy": "strand", "position": "around", "thicknessRatio": 3, "dataType": "feature", "dataMethod": "source", "dataKeys": "zoom-detail"}
    ]
  }
